{
  "name": "consuel-bot",
  "version": "1.0.0",
  "description": "Bot Playwright qui dépose une attestation Consuel sur monespaceconsuel.com, exposé en HTTP pour Google Cloud Run",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "deploy:cloudrun": "bash scripts/deploy-cloud-run.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orionenergies/consuel.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/orionenergies/consuel/issues"
  },
  "homepage": "https://github.com/orionenergies/consuel#readme",
  "dependencies": {
    "express": "^5.3.0",
    "playwright": "1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
