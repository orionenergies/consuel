# Identifiants du compte monespaceconsuel.com (en production : Secret Manager)
CONSUEL_LOGIN=
CONSUEL_PASSWORD=

# Clé d'API attendue dans le header x-api-key sur /run et /diag.
# Obligatoire quand NODE_ENV=production (Cloud Run : secret Secret Manager "api-key"), ignorée en local.
API_KEY=

# Serveur HTTP (Cloud Run injecte PORT automatiquement)
PORT=8080

# Navigateur : mettre HEADLESS=false pour voir le bot travailler en local
HEADLESS=true
SLOW_MO_MS=0

# Si true, le bot s'arrête avant "Signer et envoyer" (aucun envoi définitif)
DRY_RUN=false

# Dossier où sont enregistrées les captures d'écran en cas d'erreur
SCREENSHOT_DIR=/tmp/screenshots
# Si true, la capture d'erreur est aussi renvoyée en base64 dans la réponse HTTP
RETURN_SCREENSHOT=false

# Délai par défaut d'une action Playwright (ms) et délai global d'un run (ms)
ACTION_TIMEOUT_MS=30000
RUN_TIMEOUT_MS=840000

# Taille maximale du DRE téléchargé (octets)
DRE_MAX_BYTES=26214400
